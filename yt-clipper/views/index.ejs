<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page.title %></title>
  <meta name="description" content="<%= page.description %>">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <link rel="canonical" href="<%= canonical %>">
  <link rel="alternate" hreflang="es" href="<%= canonical %>">
  <link rel="alternate" hreflang="x-default" href="<%= canonical %>">
  <meta name="application-name" content="<%= site_name %>">
  <meta name="theme-color" content="#000180">

  <!-- Open Graph / redes sociales -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= site_name %>">
  <meta property="og:locale" content="es_ES">
  <meta property="og:title" content="<%= page.title %>">
  <meta property="og:description" content="<%= page.description %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:image" content="<%= site_url %>/static/icons/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="<%= site_name %>: descarga videos de YouTube y córtalos en clips">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= page.title %>">
  <meta name="twitter:description" content="<%= page.description %>">
  <meta name="twitter:image" content="<%= site_url %>/static/icons/og-image.png">

  <!-- Íconos / PWA -->
  <link rel="icon" href="/static/icons/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="apple-touch-icon" href="/static/icons/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="alternate" type="text/plain" title="Resumen para IA" href="/llms.txt">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&display=swap">
  <link rel="preload" href="<%= asset('fonts/Marquisette.woff2') %>" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="<%= asset('style.css') %>">

  <!-- Datos estructurados (Google, Bing y buscadores con IA) -->
  <script type="application/ld+json"><%- ld %></script>
</head>
<body>
<canvas id="bg" aria-hidden="true" style="position:fixed;inset:0;width:100%;height:100%;z-index:-1;pointer-events:none"></canvas>
<header>
  <nav class="topnav" aria-label="Principal">
    <a class="brand" href="<%= nav[0][2] %>"><img src="/static/icons/favicon.svg" alt="" width="32" height="32"> <%= site_name %></a>
    <div class="links">
      <% nav.slice(1, 6).forEach(([slug, label, href]) => { %><a href="<%= href %>"<% if (slug === page.slug) { %> aria-current="page"<% } %>><%= label %></a><% }) %>
    </div>
  </nav>
  <div class="hero">
    <h1><%= page.h1 %></h1>
    <p class="lead"><%- page.lead %></p>
    <a class="scroll-hint" href="#source" aria-label="Desliza hacia abajo para empezar">
      <svg viewBox="0 0 48 28" width="64" height="38" aria-hidden="true"><path d="M4 4l20 20L44 4" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <svg viewBox="0 0 48 28" width="64" height="38" aria-hidden="true"><path d="M4 4l20 20L44 4" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>Desliza hacia abajo</span>
    </a>
  </div>
</header>

<main>
  <!-- 1. Fuente -->
  <section class="card" id="source">
    <h2>1. Pega el enlace del video</h2>
    <form id="dl-form" class="row">
      <input id="url" type="url" placeholder="https://www.youtube.com/watch?v=…" aria-label="Enlace del video" required>
      <select id="quality" title="Calidad">
        <option value="720">720p</option>
        <option value="1080" selected>1080p</option>
        <option value="best">Máxima</option>
      </select>
      <button type="submit">Descargar</button>
    </form>
    <div class="row muted small">
      <span>…o sube un archivo:</span>
      <input id="file" type="file" accept="video/*" aria-label="Subir archivo de video">
    </div>
    <div id="dl-status" class="status hidden">
      <div class="bar"><div id="dl-bar"></div></div>
      <span id="dl-msg"></span>
    </div>
  </section>

  <!-- 2. Editor -->
  <section class="card hidden" id="editor">
    <h2 id="title">2. Editor</h2>
    <video id="player" controls preload="metadata"></video>
    <canvas id="timeline" height="56" title="Haz clic para saltar"></canvas>
    <div class="row">
      <button id="mark-in" class="ghost">Marcar inicio <kbd>I</kbd></button>
      <span id="in-out" class="mono">— → —</span>
      <button id="mark-out" class="ghost">Marcar fin <kbd>O</kbd></button>
      <button id="add-clip">Añadir clip <kbd>A</kbd></button>
    </div>

    <div class="tabs">
      <button class="tab active" data-tab="split">Dividir en partes</button>
      <button class="tab" data-tab="hl">Highlights automáticos</button>
    </div>

    <div class="pane" id="pane-split">
      <p class="muted small">Corta todo el video en partes de máximo N minutos.</p>
      <div class="row">
        <label>Máx. minutos por parte
          <input id="split-min" type="number" min="1" max="10" step="0.5" value="10">
        </label>
        <label class="check"><input id="split-equal" type="checkbox" checked> Partes iguales (evita un final muy corto)</label>
        <button id="do-split">Generar partes</button>
      </div>
    </div>

    <div class="pane hidden" id="pane-hl">
      <p class="muted small">Detecta los mejores momentos usando “Lo más visto” de YouTube (si existe) o la intensidad del audio.</p>
      <div class="row">
        <label>Cantidad <input id="hl-count" type="number" min="1" max="30" value="5"></label>
        <label>Duración (seg) <input id="hl-len" type="number" min="5" max="600" value="30"></label>
        <label>Fuente
          <select id="hl-source">
            <option value="auto">Automática</option>
            <option value="audio">Solo audio</option>
          </select>
        </label>
        <button id="do-hl">Sugerir highlights</button>
      </div>
      <p id="hl-info" class="muted small"></p>
    </div>
  </section>

  <!-- 3. Clips -->
  <section class="card hidden" id="clips-card">
    <div class="row between">
      <h2>3. Clips <span id="clip-count" class="pill">0</span></h2>
      <button id="clear" class="ghost danger">Borrar todos</button>
    </div>
    <table id="clips">
      <thead><tr><th>#</th><th>Nombre</th><th>Inicio</th><th>Fin</th><th>Duración</th><th></th></tr></thead>
      <tbody></tbody>
    </table>
    <p class="muted small">Formato de tiempo: <span class="mono">mm:ss</span> o <span class="mono">h:mm:ss</span>. Máximo 10:00 por clip.</p>

    <h3>Exportar</h3>
    <div class="row">
      <label>Formato
        <select id="fmt">
          <option value="original">Original (horizontal)</option>
          <option value="vertical">Vertical 9:16 (Shorts / Reels / TikTok)</option>
        </select>
      </label>
      <label>Calidad
        <select id="enhance">
          <option value="original">Igual al original</option>
          <option value="enhance">Mejorar nitidez y color</option>
          <option value="1080">Subir a Full HD 1080p</option>
          <option value="2160">Subir a 4K 2160p (lento)</option>
        </select>
      </label>
      <label>Corte
        <select id="precise">
          <option value="1">Preciso (re-codifica)</option>
          <option value="0">Rápido (sin re-codificar, ±segundos)</option>
        </select>
      </label>
      <button id="export" class="alt">Exportar clips</button>
    </div>
    <div id="exp-status" class="status hidden">
      <div class="bar"><div id="exp-bar"></div></div>
      <span id="exp-msg"></span>
    </div>
    <ul id="results"></ul>
    <a id="zip" class="button alt hidden" href="#">Descargar todo (ZIP)</a>
  </section>

  <!-- Contenido para buscadores y personas -->
  <section class="card content" aria-labelledby="about-h">
    <h2 id="about-h"><%= page.slug ? "Cómo lo hace " + site_name : "Qué es " + site_name %></h2>
    <p><%= page.about %></p>
  </section>

  <section class="card content" aria-labelledby="how-h">
    <h2 id="how-h">Cómo funciona</h2>
    <ol class="steps">
      <% page.steps.forEach(([name, text]) => { %><li><h3><%= name %></h3><p><%= text %></p></li><% }) %>
    </ol>
  </section>

  <section class="card content" aria-labelledby="feat-h">
    <h2 id="feat-h">Funciones</h2>
    <ul class="grid">
      <% features.forEach(([name, text]) => { %><li><h3><%= name %></h3><p><%= text %></p></li><% }) %>
    </ul>
    <h3>Sitios compatibles</h3>
    <ul class="chips"><% platforms.forEach((p) => { %><li><%= p %></li><% }) %></ul>
  </section>

  <section class="card content" aria-labelledby="faq-h">
    <h2 id="faq-h">Preguntas frecuentes</h2>
    <% faq.forEach(([q, a], i) => { %>
    <details<% if (i === 0) { %> open<% } %>><summary><%= q %></summary><p><%= a %></p></details>
    <% }) %>
  </section>

  <section class="card content" aria-labelledby="more-h">
    <h2 id="more-h">Más herramientas</h2>
    <ul class="linkgrid">
      <% nav.filter(([slug]) => slug !== page.slug).forEach(([slug, label, href]) => { %><li><a href="<%= href %>"><%= label %></a></li><% }) %>
    </ul>
  </section>
</main>

<footer class="small">
  <nav class="footnav" aria-label="Guías">
    <% nav.forEach(([slug, label, href]) => { %><a href="<%= href %>"><%= label %></a><% }) %>
  </nav>
  <p>Usa esta herramienta solo con videos propios, con licencia libre o con permiso del autor, y respeta los Términos de Servicio de cada plataforma. <%= site_name %> no está afiliado a YouTube ni a Google.</p>
  <p class="updated">Actualizado: <time datetime="<%= last_update %>"><%= last_update %></time></p>
</footer>

<script>window.MAX_CLIP = <%= max_clip %>;</script>
<script src="<%= asset('app.js') %>" defer></script>
<script src="<%= asset('bg.js') %>" defer></script>
</body>
</html>
